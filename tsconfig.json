{
	"compilerOptions": {
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"noImplicitAny": true,
		"strict": true,
		"target": "ES2022",
		"lib": ["DOM", "ES2022"],
		"types": ["node"],
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts", "test/**/*.ts"]
}
